{
  "name": "tpghelper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/select-programme.mjs msba && PROGRAMME=msba vite",
    "dev:all": "node scripts/dev-site.mjs",
    "dev:lander": "PROGRAMME=lander vite",
    "dev:msba": "node scripts/select-programme.mjs msba && PROGRAMME=msba vite",
    "dev:mgm": "node scripts/select-programme.mjs mgm && PROGRAMME=mgm vite",
    "dev:mecon": "node scripts/select-programme.mjs mecon && PROGRAMME=mecon vite",
    "build": "node scripts/select-programme.mjs msba && tsc -b && PROGRAMME=msba vite build",
    "build:lander": "PROGRAMME=lander tsc -b && PROGRAMME=lander vite build",
    "build:msba": "node scripts/select-programme.mjs msba && PROGRAMME=msba tsc -b && PROGRAMME=msba vite build",
    "build:mgm": "node scripts/select-programme.mjs mgm && PROGRAMME=mgm tsc -b && PROGRAMME=mgm vite build",
    "build:mecon": "node scripts/select-programme.mjs mecon && PROGRAMME=mecon tsc -b && PROGRAMME=mecon vite build",
    "build:site": "node scripts/build-site.mjs",
    "start": "node server/index.js",
    "db:import-courses": "node scripts/import-courses-from-public.mjs",
    "db:export-notices": "node scripts/export-teaching-plan-notices.mjs",
    "db:import-notices": "node scripts/import-notices-from-public.mjs",
    "db:import-meta": "node scripts/import-meta-from-public.mjs",
    "ce:import": "node scripts/import-common-electives.mjs",
    "ce:parse": "node scripts/import-common-electives.mjs --parse-only",
    "ce:merge": "node scripts/import-common-electives.mjs --merge-only",
    "prereq:apply": "node scripts/apply-outline-prerequisites.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@khmyznikov/pwa-install": "^0.7.0",
    "express": "^5.3.0",
    "mssql": "^12.7.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "http-proxy": "^1.18.1",
    "oxlint": "^1.93.0",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^1.3.0"
  }
