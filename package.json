{
  "name": "tpghelper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/select-programme.mjs msba && PROGRAMME=msba vite",
    "dev:all": "node scripts/dev-site.mjs",
    "dev:lander": "PROGRAMME=lander vite",
    "dev:msba": "node scripts/select-programme.mjs msba && PROGRAMME=msba vite",
    "dev:mgm": "node scripts/select-programme.mjs mgm && PROGRAMME=mgm vite",
    "dev:mecon": "node scripts/select-programme.mjs mecon && PROGRAMME=mecon vite",
    "build": "node scripts/select-programme.mjs msba && tsc -b && PROGRAMME=msba vite build",
    "build:lander": "PROGRAMME=lander tsc -b && PROGRAMME=lander vite build",
    "build:msba": "node scripts/select-programme.mjs msba && PROGRAMME=msba tsc -b && PROGRAMME=msba vite build",
    "build:mgm": "node scripts/select-programme.mjs mgm && PROGRAMME=mgm tsc -b && PROGRAMME=mgm vite build",
    "build:mecon": "node scripts/select-programme.mjs mecon && PROGRAMME=mecon tsc -b && PROGRAMME=mecon vite build",
    "build:site": "node scripts/build-site.mjs",
    "start": "node server/index.js",
    "db:import-courses": "node scripts/import-courses-from-public.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@khmyznikov/pwa-install": "^0.6.4",
    "express": "^5.2.1",
    "mssql": "^12.7.7",
